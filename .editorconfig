root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = 100
indent_size = 4

[*.py]
max_line_length = 100
indent_size = 4

[*.rst]
max_line_length = 100
indent_size = 2

[*.toml]
max_line_length = 120
indent_size = 2

[*.yml]
max_line_length = 100
indent_size = 2
